# Copy to deploy/.env (which git ignores) and fill in.

# A Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# Reusable is not needed; the node keeps its identity in the "tailscale" volume.
TS_AUTHKEY=

# The machine's name on your tailnet: the board is at https://<TS_HOSTNAME>.<tailnet>.ts.net/
TS_HOSTNAME=kanvas

# Who the agents' commits are by.
GIT_NAME=
GIT_EMAIL=
